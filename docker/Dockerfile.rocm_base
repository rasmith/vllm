# ubuntu:24.04 ships python 3.12, so the build needs no deadsnakes PPA (launchpad is not always
# reachable from a build host). The 22.04 path still works; see the python install below.
ARG BASE_IMAGE=ubuntu:24.04
# Bump to rebuild the stack (changes its key and busts every layer); upstream drift alone never does.
ARG REFRESH=2026-11-11
ARG PYTHON_VERSION=3.12
# ROCm 10.3 is only published as nightlies; every version below is from the same nightly.
ARG ROCM_SDK_VERSION=10.3.0a20261030
# torch is built from source (build_torch) under the nightly's version string, which torchvision
# pins exactly. The nightly torch, torchvision and torchaudio are installed in base first.
# The stock 10.3 torch wheels carry NO gfx1250-strict code objects (AIDEVOPS-334), so a strict
# image has to build torch itself; see build_torch.
ARG TORCH_VERSION=2.14.0+rocm${ROCM_SDK_VERSION}
ARG TORCHVISION_VERSION=0.29.0+rocm${ROCM_SDK_VERSION}
ARG TORCHAUDIO_VERSION=2.11.0.3+rocm${ROCM_SDK_VERSION}
ARG TORCH_REPO="https://github.com/ROCm/pytorch.git"
ARG TORCH_BRANCH="release/2.14" # has gfx1250-strict (ROCm/pytorch#3907)
# triton is built from source (build_triton) from ROCm/triton release_for_aiter (3.9.0). torch 2.14
# pins release/internal/3.9.x (0a6e13e6), but that has only the initial gfx1250-strict support
# (#11945): its LLVM allowed one WMMA instruction on strict, so it rejects the bf16/f16/fp8 WMMA
# that aiter's gfx1250 Gluon kernels use. release_for_aiter has the LLVM bump and #12474 (all strict
# WMMA) and #12499. TRITON_VERSION is the version that build produces.
ARG TRITON_REPO="https://github.com/ROCm/triton.git"
ARG TRITON_BRANCH="65ee8992f31b2cfdd57914a1080364c068ac9d06"
ARG TRITON_VERSION=3.9.0+git65ee8992.rocm${ROCM_SDK_VERSION}
ARG FA_BRANCH="0e60e394"
ARG FA_REPO="https://github.com/Dao-AILab/flash-attention.git"
# ROCm/aiter v0.1.29 plus the gfx1250-strict fixes: the Triton config lookup maps gfx1250-strict to
# the gfx1250 config tree (AITERKER-209), scaled WMMA (wmma_scaled, unit scales) replaces the plain
# fp8/f4 WMMA the A0 does not implement, and a BLOCK_N<=128 clamp for an a8w4 prefill correctness
# bug. NOTE: the branch name contains a slash, so it must be fetched with `git clone --branch`;
# `git checkout --detach <name>` after a plain clone cannot resolve it.
ARG AITER_BRANCH="rasmith/gfx1250-strict"
ARG AITER_REPO="https://github.com/rasmith/aiter.git"
# v1.2.5 predates ROCm/mori#874 but builds cleanly under PYTORCH_ROCM_ARCH=gfx1250-strict (its
# strict support is runtime EP/RDMA only). Use bd2e2434 if EP is needed.
ARG MORI_BRANCH="v1.2.5"
ARG MORI_REPO="https://github.com/ROCm/mori.git"
# hipBLASLt is rebuilt (build_hipblaslt) for the -strict arches in PYTORCH_ROCM_ARCH: the 10.3 SDK
# ships only gfx1250 and gfx1250v0 catalogs, no gfx1250-strict (AIDEVOPS-334). The commit is the
# SDK's own rocm-libraries commit, read out of HIPBLASLT_VERSION_TWEAK in the SDK's
# hipblaslt-version.h, so the rebuilt library matches the rest of the SDK.
ARG ROCM_LIBRARIES_REPO="https://github.com/ROCm/rocm-libraries.git"
ARG ROCM_LIBRARIES_COMMIT="db2d71e08153d4f53d67bf6b12f38a93e46dce47"
ARG ROCM_SYSTEMS_REPO="https://github.com/ROCm/rocm-systems.git"
# Empty: keep the SDK's ROCr/CLR. The 10.2 stack rebuilt them from a 10.2-only branch
# (users/rasmith/10.2/hsa_gpu_edge_signal); there is no 10.3 equivalent, and an older ROCr under a
# 10.3 SDK would be a mismatch. Set to a rocm-systems commit to re-enable the build.
ARG ROCM_RUNTIME_COMMIT=""


# TheRock configuration
ARG SITE_PACKAGES=/usr/local/lib/python${PYTHON_VERSION}/dist-packages
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL="https://stable.repo.amd.com/rocm/whl-next/" # For pre-built GPU images, packages, etc.
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL="https://nightly.repo.amd.com/rocm/whl-next/" # ROCm 10.3 SDK, torch and triton

# Build configuration
ARG PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151;gfx1250;gfx1250-strict"
ARG AITER_ROCM_ARCH="gfx942;gfx950"

FROM ${BASE_IMAGE} AS base

ARG PYTORCH_ROCM_ARCH
ENV PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}"
ARG AITER_ROCM_ARCH
ENV AITER_ROCM_ARCH="${AITER_ROCM_ARCH}"

ARG SITE_PACKAGES
ENV SITE_PACKAGES=${SITE_PACKAGES}
ENV SDK_DEV="$SITE_PACKAGES/_rocm_sdk_devel" \
    SDK_CORE="$SITE_PACKAGES/_rocm_sdk_core"
ENV ROCM_PATH="$SDK_DEV" \
    ROCM_HOME="$SDK_DEV" \
    HIP_PATH="$SDK_DEV" \
    HIP_CLANG_PATH="$SDK_DEV/lib/llvm/bin" \
    HIP_DEVICE_LIB_PATH="$SDK_CORE/lib/llvm/amdgcn/bitcode"
ENV LD_LIBRARY_PATH="$SDK_DEV/lib:$SDK_DEV/lib/rocm_sysdeps/lib:$SDK_CORE/lib:$SDK_CORE/lib/rocm_sysdeps/lib"
ENV PATH="$SDK_DEV/bin:$SDK_DEV/lib/llvm/bin:$SDK_CORE/bin:$PATH"
ENV ROCSHMEM_DIR="$SDK_DEV"

# Required for RCCL in ROCm7.1
ENV HSA_NO_SCRATCH_RECLAIM=1

ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}

ARG REFRESH
RUN echo "$REFRESH" >/etc/vllm-rocm-refresh && mkdir -p /app
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and other dependencies
# pip runs with a cache mount, so its downloads (several GB of SDK
# and torch wheels) never land in an image layer.
RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update -y \
    && apt-get install -y software-properties-common build-essential git curl sudo vim less libgfortran5 libopenmpi-dev libpci-dev liblzma-dev pkg-config libdrm-dev libnuma-dev kmod \
    # Use the distro's python when it already is PYTHON_VERSION (ubuntu:24.04 ships 3.12) and only
    # fall back to the deadsnakes PPA otherwise (ubuntu:22.04). Launchpad is not always reachable
    # from a build host, and on 24.04 nothing here needs it.
    && if ! apt-cache show python${PYTHON_VERSION} >/dev/null 2>&1; then \
        for i in 1 2 3; do \
            add-apt-repository -y ppa:deadsnakes/ppa && break || \
            { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; \
        done; \
        apt-get update -y; \
    fi \
    && apt-get install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-venv \
       python-is-python3 \
    # lib2to3 was dropped from python 3.12 and only deadsnakes still packages it.
    && { apt-get install -y python${PYTHON_VERSION}-lib2to3 || true; } \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} \
    && ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config \
    # PEP 668: ubuntu >= 24.04 marks the system interpreter externally managed, which would make
    # every pip install below fail. This image's python *is* the environment, so drop the marker.
    && rm -f /usr/lib/python${PYTHON_VERSION}/EXTERNALLY-MANAGED \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} \
    && python3 --version && python3 -m pip --version

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -U packaging 'cmake<4' ninja wheel==0.48.0 'setuptools<80' pybind11==3.0.4 Cython
RUN apt-get update && apt-get install -y libjpeg-dev libsox-dev libsox-fmt-all sox && rm -rf /var/lib/apt/lists/*

# Install ROCm SDK via TheRock
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL
ARG ROCM_SDK_VERSION
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "rocm[libraries,devel]${ROCM_SDK_VERSION:+==${ROCM_SDK_VERSION}}" \
    && rocm-sdk init

# Install PyTorch wheels (nightly for latest torch, release as fallback)
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "torch==${TORCH_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}"

# Install the AMD-compiled device kernels corresponding to PYTORCH_ROCM_ARCH:

# Possible values that can be in PYTORCH_ROCM_ARCH:
#
# gfx90a (MI210/250), gfx942 (MI300), gfx950 (MI350), gfx1100 (7900XTX),
# gfx1101 (7800XT), gfx1200 (9070XT), gfx1201 (9070), gfx1150/1151 (Strix APU),
# gfx1250 (MI450/MI455 B0), gfx1250-strict (MI455 A0)

# For each arch in PYTORCH_ROCM_ARCH, install the precompiled GPU code that
# PyTorch needs to run on that specific chip. gfx1250-strict has no device
# packages of its own: its code objects ship in the gfx1250 ones.
SHELL ["/bin/bash", "-c"]
RUN --mount=type=cache,target=/root/.cache/pip \
    TORCH_VER=$(python3 -c "import torch; print(torch.__version__)") \
    && for arch in $(echo "${PYTORCH_ROCM_ARCH}" | tr ';' '\n' | sed 's/-strict$//' | sort -u); do \
        echo "Installing device packages for ${arch}" \
        && pip install --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
            --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
            "torch[device-${arch}]==${TORCH_VER}" \
            "torchvision[device-${arch}]==${TORCHVISION_VERSION}" \
            "rocm[device-${arch}]==${ROCM_SDK_VERSION}"; \
    done

# Remove gfx90a xnack kpacks (ASAN artifacts that cause hipErrorInvalidImage on MI250)
RUN rm -f "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack+.kpack" \
         "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack-.kpack"

# rocm-sdk-core ships the amdsmi bindings as plain sources under share/amd_smi, with no
# pyproject.toml or setup.py in 10.1 through 10.3, so `pip install .` there fails. Build the
# package from those sources with tools/vllm-rocm/amdsmi/pyproject.toml, after patch-amdsmi has
# taught the loader to find libamd_smi through the installed _rocm_sdk_core rather than relative
# to the source directory. An SDK that does carry its own metadata is installed as-is.
COPY tools/vllm-rocm/therock_wheels.py /tmp/therock_wheels.py
COPY tools/vllm-rocm/amdsmi/pyproject.toml /tmp/amdsmi-pyproject.toml
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    SRC="$SITE_PACKAGES/_rocm_sdk_core/share/amd_smi"; \
    if [ -f "$SRC/pyproject.toml" ] || [ -f "$SRC/setup.py" ]; then \
        pip install "$SRC"; \
    else \
        sed -i -e 's/import regex as re/import re/' \
            -e 's/import pybase64 as base64/import base64/' /tmp/therock_wheels.py; \
        python3 /tmp/therock_wheels.py patch-amdsmi "$SRC" --out-dir /tmp/amd_smi; \
        cp /tmp/amdsmi-pyproject.toml /tmp/amd_smi/pyproject.toml; \
        pip install /tmp/amd_smi; \
    fi; \
    rm -rf /tmp/amd_smi /tmp/therock_wheels.py /tmp/amdsmi-pyproject.toml; \
    python3 -c "import amdsmi; print('amdsmi', amdsmi.__file__)"
ENV PYTHONPATH=$SITE_PACKAGES/_rocm_sdk_core/share/amd_smi

# TheRock runtime fixes
RUN if [ -f "${SITE_PACKAGES}/rocm_sdk/__init__.py" ]; then \
        sed -i 's/rtld_global: bool = True/rtld_global: bool = False/g' "${SITE_PACKAGES}/rocm_sdk/__init__.py"; \
    fi \
    && if [ -f "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" ] \
       && [ ! -e "${ROCM_PATH}/lib/librocm_smi64.so.7" ]; then \
        ln -sfn "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" "${ROCM_PATH}/lib/librocm_smi64.so.7"; \
    fi \
    && printf '%s\n%s\n' "${ROCM_PATH}/lib" "${SITE_PACKAGES}/_rocm_sdk_core/lib" > /etc/ld.so.conf.d/rocm-pip.conf \
    && for f in ${SITE_PACKAGES}/_rocm_sdk_core/lib/libamdhip64.so*; do \
        bn=$(basename "$f"); \
        if [ -f "${ROCM_PATH}/lib/${bn}" ] && [ -f "$f" ] && [ ! -L "$f" ]; then \
            rm -f "$f"; \
            ln -sfn "${ROCM_PATH}/lib/${bn}" "$f"; \
        fi; \
    done \
    && for f in librocprofiler-sdk.so.1 librocprofiler-register.so.0 \
              librocprofiler-sdk-roctx.so.1; do \
        if [ -e "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}" ] \
           && [ -e "${SITE_PACKAGES}/_rocm_sdk_devel/lib/${f}" ]; then \
            rm -f "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}"; \
            ln -sfn "${SITE_PACKAGES}/_rocm_sdk_devel/lib/${f}" \
                "${SITE_PACKAGES}/_rocm_sdk_core/lib/${f}"; \
        fi; \
    done \
    && ldconfig


###
### MORI Build
###
FROM base AS build_mori
# mori silently builds without UMBP when gRPC or Protobuf is missing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgrpc++-dev libprotobuf-dev \
       protobuf-compiler protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*
ARG MORI_BRANCH
ARG MORI_REPO
RUN git clone ${MORI_REPO}
RUN --mount=type=cache,target=/root/.cache/pip cd mori \
    && git checkout ${MORI_BRANCH} \
    && git submodule update --init --recursive \
    && ln -sfn ${ROCM_PATH} /opt/rocm \
    && pip install "setuptools_scm>=6.2" \
    && CMAKE_PREFIX_PATH="${ROCM_PATH}:${ROCM_PATH}/lib/rocm_sysdeps" \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && grep -qx 'BUILD_UMBP:BOOL=ON' build/CMakeCache.txt \
    && ls /app/mori/dist/*.whl
RUN mkdir -p /app/install && cp /app/mori/dist/*.whl /app/install

###
### FlashAttention Build
###
# FA's CK kernels have no gfx12 build at all, so with a gfx1250/gfx1250-strict-only
# PYTORCH_ROCM_ARCH there is nothing left to compile. The stage then produces no wheel and
# flash_attn is simply absent from the image (vLLM falls back to its Triton attention backends).
FROM base AS build_fa
ARG FA_BRANCH
ARG FA_REPO
RUN mkdir -p /app/install \
    && FA_ARCHS=$(echo "${PYTORCH_ROCM_ARCH}" | tr ';' '\n' | grep -v '^gfx1[0-9][0-9][0-9]' | paste -sd';') \
    && if [ -z "$FA_ARCHS" ]; then echo "No FA-capable arch in PYTORCH_ROCM_ARCH; skipping flash-attention"; exit 0; fi \
    && git clone ${FA_REPO} \
    && cd flash-attention \
    && git checkout ${FA_BRANCH} \
    && git submodule update --init \
    && GPU_ARCHS="$FA_ARCHS" python3 setup.py bdist_wheel --dist-dir=dist \
    && cp dist/*.whl /app/install


###
### AITER Build
###
FROM base AS build_aiter
ARG AITER_BRANCH
ARG AITER_REPO
RUN git clone --recursive --branch ${AITER_BRANCH} ${AITER_REPO}
RUN --mount=type=cache,target=/root/.cache/pip cd aiter \
    && git submodule update --init --recursive \
    && pip install -r requirements.txt
# AITER_USE_SYSTEM_TRITON keeps setup.py from resolving its own triton, which would
# displace the pinned one already installed in base.
RUN --mount=type=cache,target=/root/.cache/pip pip install pyyaml && cd aiter \
    && PREBUILD_KERNELS=0 AITER_USE_SYSTEM_TRITON=1 GPU_ARCHS=${AITER_ROCM_ARCH} python3 setup.py bdist_wheel --dist-dir=dist \
    && ls /app/aiter/dist/*.whl
RUN mkdir -p /app/install && cp /app/aiter/dist/*.whl /app/install


###
### Triton Build
###
# A detached checkout of TRITON_BRANCH versions the wheel 3.9.0+git<hash8>; the suffix adds .rocm<sdk>.
FROM base AS build_triton
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG ROCM_SDK_VERSION
RUN git clone --filter=blob:none ${TRITON_REPO} triton \
    && cd triton && git checkout -q ${TRITON_BRANCH}
# TRITON_BUILD_WITH_CLANG_LLD: build with clang/lld (the SDK's, on PATH), as Triton's own release
# builds do; GCC 11 rejects the MLIR code generated by release_for_aiter's LLVM.
RUN --mount=type=cache,target=/root/.cache/pip cd triton \
    && TRITON_BUILD_WITH_CLANG_LLD=1 TRITON_WHEEL_VERSION_SUFFIX=".rocm${ROCM_SDK_VERSION}" MAX_JOBS=64 \
       pip wheel --no-deps -v --wheel-dir /app/install . \
    && ls -l /app/install


###
### PyTorch Build
###
# Builds for PYTORCH_ROCM_ARCH against the SDK in base. Flash/mem-efficient attention need
# AOTriton, which has no gfx1250-strict build, so they are off (SDPA uses the math path).
FROM base AS build_torch
ARG TORCH_REPO
ARG TORCH_BRANCH
ARG TORCH_VERSION
RUN git clone --depth 1 --branch ${TORCH_BRANCH} --recurse-submodules --shallow-submodules \
        --jobs 16 ${TORCH_REPO} pytorch
# The SDK clang compiles the .hip host code and emits compiler-rt calls such as __truncsfbf2
# (float -> bf16), but the system c++ links it and its libgcc lacks them. Append the SDK's
# compiler-rt builtins to every C++ link (CMAKE_ARGS is read by scikit-build-core).
# LDFLAGS: linking bin/torch_shm_manager pulls in libamdhip64.so.7, whose DT_NEEDED
# libhsa-runtime64.so.1 sits beside it in the SDK. The 10.3 SDK records that directory only as a
# $ORIGIN-relative DT_RPATH, which ld does not expand when resolving an indirect dependency, so
# every hsa_* symbol comes out undefined. Name the SDK lib directories outright.
RUN --mount=type=cache,target=/root/.cache/pip cd pytorch \
    && pip install -r requirements.txt \
    && python3 tools/amd_build/build_amd.py \
    && BUILTINS="$("$SDK_DEV/lib/llvm/bin/clang" --rtlib=compiler-rt --print-libgcc-file-name)" \
    && test -f "$BUILTINS" \
    && USE_ROCM=1 BUILD_TEST=0 USE_FLASH_ATTENTION=0 USE_MEM_EFF_ATTENTION=0 \
       CMAKE_PREFIX_PATH="${SDK_DEV}" PYTORCH_BUILD_VERSION="${TORCH_VERSION}" PYTORCH_BUILD_NUMBER=1 \
       CMAKE_ARGS="-DCMAKE_CXX_STANDARD_LIBRARIES=${BUILTINS}" \
       LDFLAGS="-Wl,-rpath-link,${SDK_DEV}/lib:${SDK_CORE}/lib:${SDK_DEV}/lib/rocm_sysdeps/lib" \
       MAX_JOBS=128 pip wheel --no-deps --no-build-isolation -v --wheel-dir /app/install . \
    && ! nm -D --undefined-only build/lib/libtorch_hip.so | grep -w __truncsfbf2 \
    && ls -l /app/install


###
### hipBLASLt Build (gfx1250-strict)
###
# Built only for the -strict arches in PYTORCH_ROCM_ARCH; with none, /staging stays empty and the
# SDK's hipBLASLt is kept. CMake options follow TheRock (math-libs/BLAS), minus clients, tests and
# rocRoller. mxDataGenerator, which TheRock's superbuild provides, is built first.
FROM base AS build_hipblaslt
ARG ROCM_LIBRARIES_REPO
ARG ROCM_LIBRARIES_COMMIT
# msgpack: libmsgpack-dev on ubuntu 22.04, libmsgpack-cxx-dev on 24.04.
RUN apt-get update \
    && { apt-get install -y --no-install-recommends libmsgpack-dev \
         || apt-get install -y --no-install-recommends libmsgpack-cxx-dev; } \
    && rm -rf /var/lib/apt/lists/*
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCM_LIBRARIES_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/hipblaslt shared/mxdatagenerator shared/origami \
        shared/rocroller shared/stinkytofu shared/tensile \
    && git fetch --filter=blob:none --depth 1 origin ${ROCM_LIBRARIES_COMMIT} \
    && git checkout -q FETCH_HEAD
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    mkdir -p /staging/lib; \
    STRICT_ARCHS="$(echo "${PYTORCH_ROCM_ARCH}" | tr ';' '\n' | grep -- '-strict$' | paste -sd';')"; \
    if [ -z "$STRICT_ARCHS" ]; then echo "No -strict arch in PYTORCH_ROCM_ARCH; keeping the SDK's hipBLASLt"; exit 0; fi; \
    cd /src; \
    grep -v -E '^#|^\s*$|hip-python|tox|yappi|invoke' projects/hipblaslt/tensilelite/requirements.txt > /tmp/req.txt; \
    pip install -r /tmp/req.txt; \
    TOOLCHAIN="-DCMAKE_C_COMPILER=$SDK_DEV/lib/llvm/bin/amdclang -DCMAKE_CXX_COMPILER=$SDK_DEV/lib/llvm/bin/amdclang++"; \
    cmake -B /build/mxdg -G Ninja -S shared/mxdatagenerator -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/blasdeps -DCMAKE_PREFIX_PATH="$SDK_DEV" $TOOLCHAIN \
        -DGPU_TARGETS="$STRICT_ARCHS"; \
    cmake --build /build/mxdg; \
    cmake --install /build/mxdg; \
    cmake -B /build/hipblaslt -G Ninja -S projects/hipblaslt -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/hipblaslt \
        -DCMAKE_PREFIX_PATH="/opt/blasdeps;$SDK_DEV;$SDK_DEV/lib/rocm_sysdeps" $TOOLCHAIN \
        -DGPU_TARGETS="$STRICT_ARCHS" -DHIP_PLATFORM=amd \
        -DHIPBLASLT_ENABLE_CLIENT=OFF -DHIPBLASLT_ENABLE_BLIS=OFF -DHIPBLASLT_BUILD_TESTING=OFF \
        -DHIPBLASLT_INSTALL_TENSILELITE_TEST_ARTIFACTS=OFF -DTENSILELITE_BUILD_TESTING=OFF \
        -DTENSILELITE_ENABLE_CLIENT=OFF -DROCISA_USE_STABLE_ABI=ON -DHIPBLASLT_ENABLE_ROCROLLER=OFF \
        -DHIPBLASLT_ENABLE_FETCH=OFF -DHIPBLASLT_ENABLE_THEROCK=ON; \
    cmake --build /build/hipblaslt; \
    cmake --install /build/hipblaslt; \
    cd /opt/hipblaslt/lib; \
    # Same commit as the SDK, so the same sonames; the final stage relinks these file names.
    cp libhipblaslt.so.1.5 libtensilelite-host.so.1.0 /staging/lib/; \
    mkdir -p /staging/lib/hipblaslt/library; \
    cp -r hipblaslt/library/*-strict /staging/lib/hipblaslt/library/; \
    for a in $(echo "$STRICT_ARCHS" | tr ';' ' '); do \
        test -f "/staging/lib/hipblaslt/library/$a/TensileLibrary_lazy_$a.dat.zlib"; \
    done; \
    ls -l /staging/lib /staging/lib/hipblaslt/library


###
### ROCr + CLR build
###
# Brings in multi-stream perf improvements; drop after these arrive in an official release
FROM base AS build_rocm_runtime
ARG ROCM_SYSTEMS_REPO
ARG ROCM_RUNTIME_COMMIT
# libgl-dev: rocclr does find_package(OpenGL REQUIRED) unconditionally and the wheel image has
# no GL headers. The link must not pick up a libGL DT_NEEDED, which is asserted after the build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ libdw-dev xxd libgl-dev libglx-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir CppHeaderParser
# With ROCM_RUNTIME_COMMIT empty the whole build is skipped and /staging stays empty, so the
# final stage copies nothing and the SDK's own ROCr/CLR are kept.
RUN mkdir -p /staging/lib
RUN test -n "${ROCM_RUNTIME_COMMIT}" || exit 0; \
    git init -q /src && cd /src \
    && git remote add origin ${ROCM_SYSTEMS_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocr-runtime projects/clr projects/hip shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCM_RUNTIME_COMMIT} \
    && git checkout -q FETCH_HEAD
# libelf is taken from the SDK's own vendored sysdeps rather than apt -- the wheel image has no
# /usr/include/libelf.h -- so ROCr links against the copy the wheel itself was built against.
ENV SYSDEPS="$SDK_DEV/lib/rocm_sysdeps"
# ROCr first, and installed into $SDK_DEV, because the clr build below needs its headers.
RUN test -n "${ROCM_RUNTIME_COMMIT}" || exit 0; \
    cd /src/projects/rocr-runtime \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$SDK_DEV;$SYSDEPS" \
        -DCMAKE_INSTALL_PREFIX="$SDK_DEV" \
        -DLIBELF_INCLUDE_DIRS="$SYSDEPS/include" \
        -DLIBELF_LIBRARIES="$SYSDEPS/lib/libelf.so" \
    && cmake --build build --parallel 16 \
    && cmake --install build \
    && cmake --install build --prefix /rocr-install --strip
RUN test -n "${ROCM_RUNTIME_COMMIT}" || exit 0; \
    cd /src/projects/clr \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCLR_BUILD_HIP=ON \
        -DCLR_BUILD_OCL=OFF \
        -DROCM_KPACK_ENABLED=ON \
        -DHIP_COMMON_DIR=/src/projects/hip \
        -DROCM_PATH="$SDK_DEV" \
        -DCMAKE_PREFIX_PATH="$SDK_DEV;$SYSDEPS" \
        -DCMAKE_INSTALL_PREFIX="$SDK_DEV" \
        -DHIP_LLVM_ROOT="$SDK_DEV/lib/llvm" \
    && cmake --build build --parallel 16 \
    && cmake --install build --prefix /clr-install --strip
RUN test -n "${ROCM_RUNTIME_COMMIT}" || exit 0; \
    mkdir -p /staging/lib \
    && cp -P /rocr-install/lib/libhsa-runtime64.so* /staging/lib/ \
    && cp -P /clr-install/lib/libamdhip64.so* /staging/lib/ \
    && ls -l /staging/lib


###
### Final Build
###

# The stack's half of the release wheel index.
FROM base AS wheels-build
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs 2>/dev/null || true
RUN --mount=type=bind,from=build_aiter,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
# The wheel index also serves the torch built here (build_torch), which declares no triton pin
# at all and so needs no repack, and amdsmi, which TheRock ships only as sources inside
# rocm-sdk-core.
RUN --mount=type=bind,from=build_torch,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
ARG TORCH_VERSION
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL
COPY tools/vllm-rocm/therock_wheels.py /tmp/therock_wheels.py
COPY tools/vllm-rocm/amdsmi/pyproject.toml /tmp/amdsmi-pyproject.toml
# regex and pybase64 aren't installed here; fall back to the stdlib modules.
# The SDK's share/amd_smi carries no packaging metadata (see base), so supply ours unless a
# future SDK ships its own.
RUN --mount=type=cache,target=/root/.cache/pip \
    sed -i -e 's/import regex as re/import re/' \
        -e 's/import pybase64 as base64/import base64/' /tmp/therock_wheels.py \
    && python3 /tmp/therock_wheels.py patch-amdsmi "${SDK_CORE}/share/amd_smi" \
        --out-dir /tmp/amd_smi \
    && { [ -f /tmp/amd_smi/pyproject.toml ] || [ -f /tmp/amd_smi/setup.py ] \
         || cp /tmp/amdsmi-pyproject.toml /tmp/amd_smi/pyproject.toml; } \
    && pip wheel --no-deps --wheel-dir /app/debs /tmp/amd_smi \
    && rm -rf /tmp/amd_smi /tmp/therock_wheels.py /tmp/amdsmi-pyproject.toml \
    && ls -l /app/debs

FROM scratch AS wheels
COPY --from=wheels-build /app/debs /

FROM base AS final
ARG TRITON_VERSION
LABEL ai.vllm.rocm.variant=rocm103

# torch 2.12 implicitly attaches rocprofiler-sdk; its queue interposition hangs at HSA
# teardown, so disable it. TODO: drop once ROCm's stock rocprofiler carries the fix.
ENV ROCPROFILER_QUEUE_INTERPOSITION=0
# Report gfx1250-strict on MI455 A0 so its strict code objects are used. ROCr reports plain
# gfx1250 by default until AIRUNTIME-2766; this has no effect on any other GPU.
ENV HSA_DISABLE_GFX12_STRICT=0

COPY --from=build_rocm_runtime /staging/lib/ ${SDK_DEV}/lib/
# Hard link the patched library onto every stock file name, in both SDK trees, so that the
# SONAME lookup and the hard coded paths all resolve to it. Hard links rather than symlinks
# because ldconfig rewrites SONAME symlinks but cannot re-point an inode. $SDK_CORE keeps its
# own libhsa-runtime64 copy, which is on LD_LIBRARY_PATH and in ld.so.conf; relinking it is
# belt and braces rather than strictly required, but it leaves no stock ROCr in the image.
RUN set -eux; \
    cd "$SDK_DEV/lib"; \
    ours_hsa="$(readlink -f libhsa-runtime64.so.1)"; \
    ours_hip="$(readlink -f libamdhip64.so.7)"; \
    for f in "$SDK_DEV"/lib/libhsa-runtime64.so.1* "$SDK_CORE"/lib/libhsa-runtime64.so.1* \
             "$SDK_DEV"/lib/libamdhip64.so.7* "$SDK_CORE"/lib/libamdhip64.so.7*; do \
        [ -f "$f" ] && [ ! -L "$f" ] || continue; \
        case "${f##*/}" in libhsa*) ours="$ours_hsa";; *) ours="$ours_hip";; esac; \
        [ "$f" -ef "$ours" ] || ln -f "$ours" "$f"; \
    done

# Install the build_hipblaslt library, if it built one, the same way: its strict catalogs go into
# both SDK trees (librocblas and libhipblaslt look for them next to whichever copy was loaded), and
# the libraries are hard linked onto every stock file name.
RUN --mount=type=bind,from=build_hipblaslt,src=/staging/lib,target=/hipblaslt \
    set -eux; \
    [ -f /hipblaslt/libhipblaslt.so.1.5 ] || exit 0; \
    SDK_LIBS="$SITE_PACKAGES/_rocm_sdk_libraries"; \
    for d in "$SDK_DEV/lib" "$SDK_LIBS/lib"; do \
        mkdir -p "$d/hipblaslt/library"; \
        cp -r /hipblaslt/hipblaslt/library/. "$d/hipblaslt/library/"; \
    done; \
    mkdir -p /opt/hipblaslt-strict; \
    cp /hipblaslt/libhipblaslt.so.1.5 /hipblaslt/libtensilelite-host.so.1.0 /opt/hipblaslt-strict/; \
    for f in "$SDK_DEV"/lib/libhipblaslt.so* "$SDK_LIBS"/lib/libhipblaslt.so* \
             "$SDK_DEV"/lib/libtensilelite-host.so* "$SDK_LIBS"/lib/libtensilelite-host.so*; do \
        [ -f "$f" ] && [ ! -L "$f" ] || continue; \
        case "${f##*/}" in libhipblaslt*) ours=/opt/hipblaslt-strict/libhipblaslt.so.1.5;; \
                           *) ours=/opt/hipblaslt-strict/libtensilelite-host.so.1.0;; esac; \
        ln -f "$ours" "$f"; \
    done

RUN ldconfig

# Runtime libraries of mori's UMBP extension. The soname is in the package name and changes with
# the distro (libgrpc++1/libprotobuf23 on 22.04, libgrpc++1.51t64/libprotobuf32t64 on 24.04), so
# resolve them from the archive instead of hard coding. `from mori.cpp import UMBPClient` below
# fails the build if this picked the wrong ones.
RUN apt-get update \
    && GRPC=$(apt-cache --names-only search '^libgrpc\+\+[0-9]' | cut -d' ' -f1 | sort | tail -1) \
    && PROTOBUF=$(apt-cache --names-only search '^libprotobuf[0-9]' | cut -d' ' -f1 | sort | tail -1) \
    && echo "mori UMBP runtime: $GRPC $PROTOBUF" \
    && test -n "$GRPC" && test -n "$PROTOBUF" \
    && apt-get install -y --no-install-recommends "$GRPC" "$PROTOBUF" \
    && rm -rf /var/lib/apt/lists/*

# Replace the nightly torch and triton with the source builds. The nightly torch has no
# gfx1250-strict code objects at all (AIDEVOPS-334), which is the whole reason build_torch exists.
# torch keeps the nightly's version string, so --force-reinstall; --no-deps because the built
# torch declares no triton pin.
RUN --mount=type=bind,from=build_torch,src=/app/install,target=/i/torch \
    --mount=type=bind,from=build_triton,src=/app/install,target=/i/triton \
    --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps --force-reinstall /i/torch/*.whl /i/triton/*.whl

# This is to prevent resolvers from checking METADATA and RECORD and clobbering
# the Triton source build we installed. Constraints files are unable to help
# with this. However, these entries are optional and can be blanked which
# solves the problem. The source-built torch usually declares no triton pin at all.
RUN TORCH_DIST_INFO=$(ls -d ${SITE_PACKAGES}/torch-*.dist-info) \
    && if grep -q '^Requires-Dist: triton' "$TORCH_DIST_INFO/METADATA"; then \
        sed -i '/^Requires-Dist: triton/d' "$TORCH_DIST_INFO/METADATA"; \
        sed -i "s|^\(${TORCH_DIST_INFO##*/}/METADATA\),.*|\1,,|" "$TORCH_DIST_INFO/RECORD"; \
    fi

RUN --mount=type=bind,from=build_fa,src=/app/install,target=/i/fa \
    --mount=type=bind,from=build_aiter,src=/app/install,target=/i/aiter \
    --mount=type=bind,from=build_mori,src=/app/install,target=/i/mori \
    --mount=type=cache,target=/root/.cache/pip \
    # pyyaml: aiter.dist.utils imports it, so `import aiter` fails without it, and aiter's own
    # wheel does not declare it.
    shopt -s nullglob && pip install pyyaml /i/*/*.whl \
    && ! pip check 2>&1 | grep -iE '^(torch|triton) ' \
    && test "$(pip show triton | awk '/^Version:/ {print $2}')" = "${TRITON_VERSION}" \
    # Create a constraints file to protect the versions we need, especially
    # triton, requirements will try to reinstall repeatedly.
    && pip list --format=freeze \
        | grep -E '^(torch|triton|torchaudio|torchvision|pybind11)==' > /etc/rocm-constraints.txt \
    && echo "ROCm constraints:" && cat /etc/rocm-constraints.txt \
    && test "$(wc -l < /etc/rocm-constraints.txt)" -eq 5 \
    && grep -q '^pybind11==3\.0\.' /etc/rocm-constraints.txt \
    && python3 -c "import torch; assert torch.version.hip, f'non-ROCm torch: {torch.__version__}'; print(f'torch={torch.__version__}')" \
    && python3 -c "import triton; print(f'triton={triton.__version__}')" \
    && python3 -c "from mori.cpp import UMBPClient" \
    && pip list 2>/dev/null | grep -iE '^(torch|triton) '

# Fail if a pip call above ran without the cache mount and left its downloads in the image.
RUN if [ -n "$(ls -A /root/.cache/pip 2>/dev/null)" ]; then \
        du -sh /root/.cache/pip; \
        echo "ERROR: /root/.cache/pip is not empty; add --mount=type=cache,target=/root/.cache/pip" >&2; \
        exit 1; \
    fi

ARG BASE_IMAGE
ARG PYTHON_VERSION
ARG ROCM_SDK_VERSION
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
ARG PYTORCH_ROCM_ARCH
ARG AITER_ROCM_ARCH
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG FA_BRANCH
ARG FA_REPO
ARG AITER_BRANCH
ARG AITER_REPO
ARG MORI_BRANCH
ARG MORI_REPO
ARG ROCM_SYSTEMS_REPO
ARG ROCM_RUNTIME_COMMIT
ARG ROCM_LIBRARIES_REPO
ARG ROCM_LIBRARIES_COMMIT
ARG TORCH_REPO
ARG TORCH_BRANCH
ARG TRITON_VERSION
RUN echo "BASE_IMAGE: ${BASE_IMAGE}" > /app/versions.txt \
    && echo "PYTHON_VERSION: ${PYTHON_VERSION}" >> /app/versions.txt \
    && echo "ROCM_SDK_VERSION: ${ROCM_SDK_VERSION}" >> /app/versions.txt \
    && echo "TORCH_VERSION: ${TORCH_VERSION}" >> /app/versions.txt \
    && echo "TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION}" >> /app/versions.txt \
    && echo "TORCHVISION_VERSION: ${TORCHVISION_VERSION}" >> /app/versions.txt \
    && echo "PYTORCH_ROCM_ARCH: ${PYTORCH_ROCM_ARCH}" >> /app/versions.txt \
    && echo "AITER_ROCM_ARCH: ${AITER_ROCM_ARCH}" >> /app/versions.txt \
    && echo "TRITON_BRANCH: ${TRITON_BRANCH}" >> /app/versions.txt \
    && echo "TRITON_REPO: ${TRITON_REPO}" >> /app/versions.txt \
    && echo "FA_BRANCH: ${FA_BRANCH}" >> /app/versions.txt \
    && echo "FA_REPO: ${FA_REPO}" >> /app/versions.txt \
    && echo "AITER_BRANCH: ${AITER_BRANCH}" >> /app/versions.txt \
    && echo "AITER_REPO: ${AITER_REPO}" >> /app/versions.txt \
    && echo "MORI_BRANCH: ${MORI_BRANCH}" >> /app/versions.txt \
    && echo "MORI_REPO: ${MORI_REPO}" >> /app/versions.txt \
    && echo "ROCM_SYSTEMS_REPO: ${ROCM_SYSTEMS_REPO}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_COMMIT: ${ROCM_RUNTIME_COMMIT:-(SDK stock ROCr/CLR)}" >> /app/versions.txt \
    && echo "TORCH_SOURCE: ${TORCH_REPO} ${TORCH_BRANCH} $(python3 -c 'import torch; print(torch.version.git_version)')" >> /app/versions.txt \
    && echo "HIPBLASLT_SOURCE: ${ROCM_LIBRARIES_REPO} ${ROCM_LIBRARIES_COMMIT} (gfx1250-strict: $(ls /opt/hipblaslt-strict 2>/dev/null | tr '\n' ' '))" >> /app/versions.txt \
    && echo "TRITON_VERSION: $(pip show triton | awk '/^Version:/ {print $2}')" >> /app/versions.txt \
    && echo "PYBIND11_VERSION: $(pip show pybind11 | awk '/^Version:/ {print $2}')" >> /app/versions.txt
