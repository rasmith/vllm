ARG BASE_IMAGE=ubuntu:22.04
ARG PYTHON_VERSION=3.12
ARG TORCH_VERSION=2.12.0+rocm7.14.0
ARG TORCHVISION_VERSION=0.27.0+rocm7.14.0
ARG TORCHAUDIO_VERSION=2.11.0+rocm7.14.0
ARG TRITON_BRANCH="f0b55c07da61c71775bef6d1a15ebf846430ac75" # release/internal/3.7.x as of 08/13
ARG TRITON_REPO="https://github.com/ROCm/triton.git"
ARG FA_BRANCH="0e60e394"
ARG FA_REPO="https://github.com/Dao-AILab/flash-attention.git"
ARG AITER_BRANCH="v0.1.19"
ARG AITER_REPO="https://github.com/ROCm/aiter.git"
ARG MORI_BRANCH="f95cd5e0ca7b730f92f9ffdfb358484d6965d9f7" # TheRock compatible v1.1.0
ARG MORI_REPO="https://github.com/ROCm/mori.git"
ARG ROCPROFILER_SDK_REPO="https://github.com/ROCm/rocm-systems.git"
ARG ROCPROFILER_SDK_COMMIT="2b22ab0195cc1461cd9abf3b969e9dd7c10af350"
ARG ROCM_RUNTIME_REPO="https://github.com/mawong-amd/rocm-systems.git"
ARG ROCM_RUNTIME_COMMIT="cf439e5fd07ff22f50dec4e1659719c33d53c44c" # 7.14/hsa_gpu_edge_signal
ARG AOTRITON_REPO="https://github.com/ROCm/aotriton.git"
ARG AOTRITON_TAG="0.11.2b" # Stock upstream, native SONAME libaotriton_v2.so.0.11.2
ARG AOTRITON_DB_TAG="0.13.50tp" # Donor for the gfx950 forward tuning DB, nothing else
ARG AOTRITON_DB_SHA256="f981eb3db4a095d9eb308e2d5e150b1e063ab9f5f40a140c8369353aadd871cf"
# Set to 1 only for single-arch iteration builds. Ship builds must leave it 0 so
# a narrowed PYTORCH_ROCM_ARCH cannot silently drop arches torch still expects.
ARG AOTRITON_ALLOW_PARTIAL_ARCH="0"


# TheRock configuration
ARG SITE_PACKAGES=/usr/local/lib/python${PYTHON_VERSION}/dist-packages
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL="https://repo.amd.com/rocm/whl-multi-arch/" # For pre-built GPU images, packages, etc.
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL="https://rocm.nightlies.amd.com/whl-multi-arch/" # For torch, triton, etc. wheels with latest fixes.
ARG ROCM_SDK_VERSION=7.14.0

# Build configuration
ARG PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151"
ARG AITER_ROCM_ARCH="gfx942;gfx950"
ARG MAX_JOBS

# Sccache configuration (only used in release pipeline)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME=vllm-build-sccache
ARG SCCACHE_REGION_NAME=us-west-2
ARG SCCACHE_S3_NO_CREDENTIALS=0

FROM ${BASE_IMAGE} AS base

ARG PYTORCH_ROCM_ARCH
ENV PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}"
ARG AITER_ROCM_ARCH
ENV AITER_ROCM_ARCH="${AITER_ROCM_ARCH}"

ARG SITE_PACKAGES
ENV SITE_PACKAGES=${SITE_PACKAGES}
ENV SDK_DEV="$SITE_PACKAGES/_rocm_sdk_devel" \
    SDK_CORE="$SITE_PACKAGES/_rocm_sdk_core"
ENV ROCM_PATH="$SDK_DEV" \
    ROCM_HOME="$SDK_DEV" \
    HIP_PATH="$SDK_DEV" \
    HIP_CLANG_PATH="$SDK_DEV/lib/llvm/bin" \
    HIP_DEVICE_LIB_PATH="$SDK_CORE/lib/llvm/amdgcn/bitcode"
ENV LD_LIBRARY_PATH="$SDK_DEV/lib:$SDK_DEV/lib/rocm_sysdeps/lib:$SDK_CORE/lib:$SDK_CORE/lib/rocm_sysdeps/lib"
ENV PATH="$SDK_DEV/bin:$SDK_DEV/lib/llvm/bin:$SDK_CORE/bin:$PATH"

# Required for RCCL in ROCm7.1
ENV HSA_NO_SCRATCH_RECLAIM=1

ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}

RUN mkdir -p /app
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and other dependencies
RUN apt-get update -y \
    && apt-get install -y software-properties-common build-essential git curl sudo vim less libgfortran5 libopenmpi-dev libpci-dev liblzma-dev pkg-config libdrm-dev libnuma-dev kmod \
    && for i in 1 2 3; do \
        add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; \
    done \
    && apt-get update -y \
    && apt-get install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-lib2to3 python-is-python3 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} \
    && ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} \
    && python3 --version && python3 -m pip --version

RUN pip install -U packaging 'cmake<4' ninja wheel 'setuptools<80' pybind11==3.0.4 Cython
RUN apt-get update && apt-get install -y libjpeg-dev libsox-dev libsox-fmt-all sox && rm -rf /var/lib/apt/lists/*

# Install ROCm SDK via TheRock
ARG ROCM_RELEASE_WHEELS_MULTIARCH_URL
ARG ROCM_NIGHTLY_WHEELS_MULTIARCH_URL
ARG ROCM_SDK_VERSION
RUN pip install --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "rocm[libraries,devel]${ROCM_SDK_VERSION:+==${ROCM_SDK_VERSION}}" \
    && rocm-sdk init

# Install PyTorch wheels (nightly for latest torch, release as fallback)
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
RUN pip install \
    --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
    --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
    "torch==${TORCH_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}"
RUN python3 -c "import torch; print(f'torch={torch.__version__}, hip={torch.version.hip}')"

# Install the AMD-compiled device kernels corresponding to PYTORCH_ROCM_ARCH:

# Possible values that can be in PYTORCH_ROCM_ARCH:
#
# gfx90a (MI210/250), gfx942 (MI300), gfx950 (MI350), gfx1100 (7900XTX),
# gfx1101 (7800XT), gfx1200 (9070XT), gfx1201 (9070), gfx1150/1151 (Strix APU)

# For each arch in PYTORCH_ROCM_ARCH, install the precompiled GPU code that
# PyTorch needs to run on that specific chip.
SHELL ["/bin/bash", "-c"]
RUN TORCH_VER=$(python3 -c "import torch; print(torch.__version__)") \
    && for arch in $(echo "${PYTORCH_ROCM_ARCH}" | tr ';' ' '); do \
        echo "Installing device packages for ${arch}" \
        && pip install --index-url ${ROCM_RELEASE_WHEELS_MULTIARCH_URL} \
            --extra-index-url ${ROCM_NIGHTLY_WHEELS_MULTIARCH_URL} \
            amd-torch-device-${arch}==${TORCH_VER} \
            rocm-sdk-device-${arch}==${ROCM_SDK_VERSION}; \
    done

# Remove gfx90a xnack kpacks (ASAN artifacts that cause hipErrorInvalidImage on MI250)
RUN rm -f "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack+.kpack" \
         "${SITE_PACKAGES}/torch/.kpack/torch_gfx90a:xnack-.kpack"

RUN cd $SITE_PACKAGES/_rocm_sdk_core/share/amd_smi && pip install .
ENV PYTHONPATH=$SITE_PACKAGES/_rocm_sdk_core/share/amd_smi

# TheRock runtime fixes
RUN if [ -f "${SITE_PACKAGES}/rocm_sdk/__init__.py" ]; then \
        sed -i 's/rtld_global: bool = True/rtld_global: bool = False/g' "${SITE_PACKAGES}/rocm_sdk/__init__.py"; \
    fi \
    && if [ -f "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" ] \
       && [ ! -e "${ROCM_PATH}/lib/librocm_smi64.so.7" ]; then \
        ln -sfn "${SITE_PACKAGES}/_rocm_sdk_core/lib/librocm_smi64.so.1" "${ROCM_PATH}/lib/librocm_smi64.so.7"; \
    fi \
    && printf '%s\n%s\n' "${ROCM_PATH}/lib" "${SITE_PACKAGES}/_rocm_sdk_core/lib" > /etc/ld.so.conf.d/rocm-pip.conf \
    && for f in ${SITE_PACKAGES}/_rocm_sdk_core/lib/libamdhip64.so*; do \
        bn=$(basename "$f"); \
        if [ -f "${ROCM_PATH}/lib/${bn}" ] && [ -f "$f" ] && [ ! -L "$f" ]; then \
            rm -f "$f"; \
            ln -sfn "${ROCM_PATH}/lib/${bn}" "$f"; \
        fi; \
    done \
    && ldconfig

# Install sccache if USE_SCCACHE is enabled (for release builds)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME
ARG SCCACHE_REGION_NAME
ARG SCCACHE_S3_NO_CREDENTIALS
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Installing sccache..." \
        && SCCACHE_ARCH="x86_64" \
        && SCCACHE_VERSION="v0.8.1" \
        && SCCACHE_DL_URL="${SCCACHE_DOWNLOAD_URL:-https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl.tar.gz}" \
        && curl -L -o /tmp/sccache.tar.gz ${SCCACHE_DL_URL} \
        && tar -xzf /tmp/sccache.tar.gz -C /tmp \
        && mv /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl/sccache /usr/bin/sccache \
        && chmod +x /usr/bin/sccache \
        && rm -rf /tmp/sccache.tar.gz /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl \
        && sccache --version; \
    fi

# Setup sccache for HIP compilation via HIP_CLANG_PATH
# This creates wrapper scripts in a separate directory and points HIP to use them
# This avoids modifying the original ROCm binaries which can break detection
# NOTE: HIP_CLANG_PATH is NOT set as ENV to avoid affecting downstream images (Dockerfile.rocm)
# Instead, each build stage should export HIP_CLANG_PATH=/opt/sccache-wrappers if USE_SCCACHE=1
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Setting up sccache wrappers for HIP compilation..." \
        && mkdir -p /opt/sccache-wrappers \
        && printf '#!/bin/bash\nexec sccache %s/lib/llvm/bin/clang++ "$@"\n' "${ROCM_PATH}" > /opt/sccache-wrappers/clang++ \
        && chmod +x /opt/sccache-wrappers/clang++ \
        && printf '#!/bin/bash\nexec sccache %s/lib/llvm/bin/clang "$@"\n' "${ROCM_PATH}" > /opt/sccache-wrappers/clang \
        && chmod +x /opt/sccache-wrappers/clang \
        && echo "sccache wrappers created in /opt/sccache-wrappers"; \
    fi

ENV SCCACHE_BUCKET=${USE_SCCACHE:+${SCCACHE_BUCKET_NAME}}
ENV SCCACHE_REGION=${USE_SCCACHE:+${SCCACHE_REGION_NAME}}
ENV SCCACHE_S3_NO_CREDENTIALS=${USE_SCCACHE:+${SCCACHE_S3_NO_CREDENTIALS}}
ENV SCCACHE_IDLE_TIMEOUT=${USE_SCCACHE:+0}


###
### Triton Build
###
FROM base AS build_triton
ARG TRITON_BRANCH
ARG TRITON_REPO
RUN git clone ${TRITON_REPO}
RUN cd triton \
    && git checkout ${TRITON_BRANCH} \
    && if [ ! -f setup.py ]; then cd python; fi \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && mkdir -p /app/install && cp dist/*.whl /app/install


###
### MORI Build
###
FROM base AS build_mori
ARG MORI_BRANCH
ARG MORI_REPO
RUN git clone ${MORI_REPO}
RUN cd mori \
    && git checkout ${MORI_BRANCH} \
    && git submodule update --init --recursive \
    && ln -sfn ${ROCM_PATH} /opt/rocm \
    && mkdir -p /usr/lib64 && ln -sf /usr/lib/x86_64-linux-gnu/libc.so /usr/lib64/libc.so \
    && python3 setup.py bdist_wheel --dist-dir=dist && ls /app/mori/dist/*.whl
RUN mkdir -p /app/install && cp /app/mori/dist/*.whl /app/install

###
### FlashAttention Build
###
FROM base AS build_fa
ARG FA_BRANCH
ARG FA_REPO
ARG USE_SCCACHE
RUN git clone ${FA_REPO}
RUN cd flash-attention \
    && git checkout ${FA_BRANCH} \
    && git submodule update --init \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && GPU_ARCHS=$(echo ${PYTORCH_ROCM_ARCH} | sed -e 's/;gfx1[0-9]\{3\}//g') python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/flash-attention/dist/*.whl /app/install


###
### AITER Build
###
FROM base AS build_aiter
ARG AITER_BRANCH
ARG AITER_REPO
ARG USE_SCCACHE
RUN git clone --recursive --branch ${AITER_BRANCH} ${AITER_REPO}
RUN cd aiter \
    && git submodule update --init --recursive \
    && pip install -r requirements.txt
# AITER_USE_SYSTEM_TRITON keeps setup.py off the index triton, which would
# otherwise displace the one we built.
RUN pip install pyyaml && cd aiter \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && PREBUILD_KERNELS=1 AITER_USE_SYSTEM_TRITON=1 GPU_ARCHS=${AITER_ROCM_ARCH} python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi \
    && ls /app/aiter/dist/*.whl
RUN mkdir -p /app/install && cp /app/aiter/dist/*.whl /app/install


###
### Final Build
###

# Wheel release stage - 
# only includes dependencies used by wheel release pipeline
FROM base AS debs_wheel_release
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_aiter,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs

FROM base AS debs
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_aiter,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_mori,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs

# rocprofiler-sdk 1.3.2 fixes torch 2.12 profiler on ROCm 7.2.3
FROM base AS build_rocprofiler_sdk
ARG ROCPROFILER_SDK_REPO
ARG ROCPROFILER_SDK_COMMIT
ARG USE_SCCACHE
RUN apt-get update \
    && apt-get install -y --no-install-recommends libdw-dev libelf-dev libsqlite3-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCPROFILER_SDK_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocprofiler-sdk shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCPROFILER_SDK_COMMIT} \
    && git checkout -q FETCH_HEAD
RUN cd /src/projects/rocprofiler-sdk \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export CMAKE_C_COMPILER_LAUNCHER=sccache \
           && export CMAKE_CXX_COMPILER_LAUNCHER=sccache; \
       fi \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DCMAKE_INSTALL_PREFIX=/opt/rocm \
        -DROCPROFILER_BUILD_TESTS=OFF \
        -DROCPROFILER_BUILD_SAMPLES=OFF \
        -DROCPROFILER_BUILD_DOCS=OFF \
    && cmake --build build --parallel "$(nproc)" \
    && cmake --install build --prefix /staging --strip


###
### ROCr + CLR build
###
# Matt Wong's ordering-edge-signal stack, branched off the same rocm-systems 7.14 commit
# the rocprofiler-sdk build above pins. ROCr grows hsa_amd_signal_create_v2, which hands
# out signals whose value word lives in device memory; clr keeps a per device pool of them
# and names one in barrier_packet_.dep_signal[] instead of a host resident signal, so an
# ordering edge between two queues no longer costs a host round trip. That is the decode
# latency win measured in vllm-project/vllm#53712, which did the same thing for the apt
# ROCm 7.2.3 base image. Here the SDK arrives as TheRock wheels, so the build targets
# ${ROCM_PATH} and the sysdeps the wheels bundle rather than /opt/rocm.
FROM base AS build_rocm_runtime
ARG ROCM_RUNTIME_REPO
ARG ROCM_RUNTIME_COMMIT
ARG MAX_JOBS
# clr calls find_package(OpenGL REQUIRED) whether or not GL interop is wanted, and ROCr's
# header codegen wants CppHeaderParser and xxd. elf, drm and numa deliberately come from
# the SDK's rocm_sysdeps and not from apt, so the rebuilt libraries carry the same
# librocm_sysdeps_* DT_NEEDED entries as the wheels' own.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl-dev libglx-dev mesa-common-dev xxd \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir CppHeaderParser
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCM_RUNTIME_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocr-runtime projects/clr projects/hip shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCM_RUNTIME_COMMIT} \
    && git checkout -q FETCH_HEAD
# ROCr first, and installed over the SDK, because clr's rocrctx.hpp needs the
# hsa_amd_signal_create_desc_t that this adds to hsa_ext_amd.h.
RUN cd /src/projects/rocr-runtime \
    && PKG_CONFIG_PATH=${ROCM_PATH}/lib/rocm_sysdeps/lib/pkgconfig \
       cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="${ROCM_PATH}/lib/rocm_sysdeps;${ROCM_PATH}" \
        -DCMAKE_INSTALL_PREFIX="${ROCM_PATH}" \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_INSTALL_RPATH='$ORIGIN:$ORIGIN/rocm_sysdeps/lib' \
    && cmake --build build --parallel ${MAX_JOBS:-$(nproc)} \
    && cmake --install build \
    && cmake --install build --prefix /rocr-install --strip
# ROCM_KPACK_ENABLED is off by default upstream but on in the wheels: without it hip
# refuses the split device code in the amd-torch-device-gfx* packages with
# "Kpack code object but ROCM_KPACK_ENABLED=OFF".
RUN cd /src/projects/clr \
    && PKG_CONFIG_PATH=${ROCM_PATH}/lib/rocm_sysdeps/lib/pkgconfig \
       cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCLR_BUILD_HIP=ON \
        -DCLR_BUILD_OCL=OFF \
        -DHIP_COMMON_DIR=/src/projects/hip \
        -DROCM_PATH="${ROCM_PATH}" \
        -DCMAKE_PREFIX_PATH="${ROCM_PATH}/lib/rocm_sysdeps;${ROCM_PATH}" \
        -DCMAKE_INSTALL_PREFIX="${ROCM_PATH}" \
        -DHIP_LLVM_ROOT="${ROCM_PATH}/lib/llvm" \
        -DPROF_API_HEADER_PATH="${ROCM_PATH}/include/roctracer/ext" \
        -DROCM_KPACK_ENABLED=ON \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_INSTALL_RPATH='$ORIGIN:$ORIGIN/rocm_sysdeps/lib:$ORIGIN/llvm/lib' \
    && cmake --build build --parallel ${MAX_JOBS:-$(nproc)} \
    && cmake --install build --prefix /clr-install --strip
RUN mkdir -p /staging/lib \
    && cp -P /rocr-install/lib/libhsa-runtime64.so* /staging/lib/ \
    && cp -P /clr-install/lib/libamdhip64.so* /staging/lib/ \
    && ls -l /staging/lib


###
### AOTriton Build
###
# torch 2.12 bundles AOTriton 0.11.2, whose mem-efficient attention is wrong on gfx950:
# four test_prefix_prefill.py ALiBi ids miss atol=1e-6 by 3e-5 to 5e-4. The forward
# kernel source is functionally identical between 0.11.2b and 0.13.50 on that path, so
# the cause is the gfx950 forward tuning database, and swapping just that file closes
# all four. See ~/claude/aotriton/CANDIDATES.md for the measurements.
#
# MEASURED COST, read before shipping this: on a 48-shape SDPA sweep the swap is a
# median 15% slower than stock 0.11.2 and 19% slower in aggregate than the
# AOTRITON_COMPAT_ABI_0_11 build of 0.13.50 that this stage replaces. It buys
# correctness with throughput. The compat build was both correct and faster.
FROM base AS build_aotriton
ARG AOTRITON_REPO
ARG AOTRITON_TAG
ARG AOTRITON_DB_TAG
ARG AOTRITON_DB_SHA256
ARG MAX_JOBS
RUN git clone --depth 1 --branch ${AOTRITON_TAG} --recursive ${AOTRITON_REPO} aotriton
WORKDIR /app/aotriton
# The tuning database is a BUILD-TIME input, not a runtime file, so it has to be in
# place before cmake configures. v3python/kernel/kdesc.py:translate_dataframe() derives
# the set of kernel signatures to compile straight from the database rows, which is why
# this swap changes what gets built at all (21216 -> 23162 ninja targets). Copying the
# file into a finished image would do nothing whatsoever.
#
# Pinned to a tag, not a branch: the database decides which kernels exist, so a moving
# tip would silently change the contents of the image. The sha256 check is what makes
# that failure loud. Note the directory was renamed between the two versions --
# modules/database in 0.13.50, v3python/database in 0.11.2b -- so this copies one file
# to a different path, it does not merge trees.
RUN DST=v3python/database/amd/gfx950/flash/attn_fwd.sqlite3.tar.xz \
    && test -f ${DST} \
    && git fetch --depth 1 origin refs/tags/${AOTRITON_DB_TAG} \
    && git show FETCH_HEAD:modules/database/amd/gfx950/flash/attn_fwd.sqlite3.tar.xz > ${DST} \
    && echo "${AOTRITON_DB_SHA256}  ${DST}" | sha256sum -c - \
    && echo "gfx950 attn_fwd tuning DB <- ${AOTRITON_DB_TAG}"
RUN pip install -r requirements.txt \
    && pip wheel third_party/triton -w /app/aotriton/triton_wheel
# Only the CDNA arches, the ones the torch wheels ship aotriton.images for -- same
# filter build_fa uses, and compiling the Triton kernel images costs hours per arch.
# AOTRITON_COMPAT_ABI_0_11 is deliberately absent: 0.11.2b already is the ABI and the
# SONAME torch links against, which is the point of building this tag. NO_PYTHON is
# kept because that is the configuration the accuracy result was measured with.
RUN cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/app/aotriton/install_dir \
        -DCMAKE_BUILD_TYPE=Release \
        -DAOTRITON_TARGET_ARCH="$(echo ${PYTORCH_ROCM_ARCH} | sed -e 's/;gfx1[0-9]\{3\}//g')" \
        -DAOTRITON_GPU_BUILD_TIMEOUT=0 \
        -DAOTRITON_NO_PYTHON=ON \
        -DAOTRITON_USE_LOCAL_TRITON_WHEEL=$(ls /app/aotriton/triton_wheel/triton-*.whl | head -1) \
    && ninja -C build -j ${MAX_JOBS:-$(nproc)} install/strip
RUN mkdir -p /app/install/aotriton \
    && cp -a install_dir/lib/libaotriton_v2.so.0.11.2 /app/install/aotriton/ \
    && cp -a install_dir/lib/aotriton.images /app/install/aotriton/ \
    && ls /app/install/aotriton/aotriton.images
WORKDIR /app


FROM base AS final

# Remove the torch wheel's Requires-Dist: triton entry in METADATA and the SHA
# hash (its optional) from RECORD.  These will cause Python to reinstall
# Triton and a constraints file can't fix it. This doesn't exist for source 
# builds, so it wasn't needed there.
RUN TORCH_DIST_INFO=$(ls -d ${SITE_PACKAGES}/torch-*.dist-info) \
    && grep -q '^Requires-Dist: triton' "$TORCH_DIST_INFO/METADATA" \
    && sed -i '/^Requires-Dist: triton/d' "$TORCH_DIST_INFO/METADATA" \
    && sed -i "s|^\(${TORCH_DIST_INFO##*/}/METADATA\),.*|\1,,|" "$TORCH_DIST_INFO/RECORD"

# Other wheels first, so they resolve against the index triton. Ours goes in last
# with --no-deps, where it can't pull the resolver anywhere.
RUN --mount=type=bind,from=debs,src=/app/debs,target=/install \
    pip install $(ls /install/*.whl | grep -v '/triton-') \
    && pip install --no-deps --force-reinstall /install/triton-*.whl \
    # With the pin gone this must be clean, so any complaint is real.
    && ! pip check 2>&1 | grep -iE '^(torch|triton) ' \
    # Create a constraints file to protect the versions we need, especially
    # triton, requirements will try to reinstall repeatedly.
    && pip list --format=freeze \
        | grep -E '^(torch|triton|torchaudio|torchvision|pybind11)==' > /etc/rocm-constraints.txt \
    && echo "ROCm constraints:" && cat /etc/rocm-constraints.txt \
    && test "$(wc -l < /etc/rocm-constraints.txt)" -eq 5 \
    && grep -q '^pybind11==3\.0\.' /etc/rocm-constraints.txt \
    && python3 -c "import torch; assert torch.version.hip, f'non-ROCm torch: {torch.__version__}'; print(f'torch={torch.__version__}')" \
    && python3 -c "import triton; print(f'triton={triton.__version__}')" \
    && pip list 2>/dev/null | grep -iE '^(torch|triton) '

# Swap our AOTriton in. Same 0.11.2 SONAME and same images layout as the wheel's copy,
# but the two are a matched pair and must move together: the autotune lookup tables are
# compiled into the .so and they index the kernel images by name, so a new .so against
# the wheel's images would select variants that are not there. Replaced wholesale, not
# merged. The import is the real test -- libtorch_hip DT_NEEDEDs
# libaotriton_v2.so.0.11.2, so a bad library fails to resolve.
# Declared here rather than in the versions.txt block below because this RUN needs them.
ARG AOTRITON_REPO
ARG AOTRITON_TAG
ARG AOTRITON_DB_TAG
ARG AOTRITON_ALLOW_PARTIAL_ARCH
RUN --mount=type=bind,from=build_aotriton,src=/app/install/aotriton,target=/aotriton \
    TORCH_LIB=$(python3 -c "import torch, os; print(os.path.dirname(torch.__file__))")/lib \
    && SHIPPED=$(ls ${TORCH_LIB}/aotriton.images) \
    && rm -rf ${TORCH_LIB}/aotriton.images \
    && cp -a /aotriton/aotriton.images ${TORCH_LIB}/ \
    && cp -a /aotriton/libaotriton_v2.so.0.11.2 ${TORCH_LIB}/ \
    && ln -sfn libaotriton_v2.so.0.11.2 ${TORCH_LIB}/libaotriton_v2.so \
    && strings ${TORCH_LIB}/libaotriton_v2.so.0.11.2 | grep -q 'AOTriton 0\.11\.2' \
    && for d in ${SHIPPED}; do \
           ls -A ${TORCH_LIB}/aotriton.images/${d}/flash/attn_fwd 2>/dev/null | grep -q . \
           || { echo "torch shipped AOTriton images for ${d#amd-} but the build did not;" \
                     "widen the arch filter in build_aotriton"; \
                test "${AOTRITON_ALLOW_PARTIAL_ARCH}" = "1" \
                || exit 1; }; \
       done \
    && ls ${TORCH_LIB}/aotriton.images | sed 's/^amd-//' | paste -sd';' \
        > /app/aotriton_archs.txt \
    && echo "AOTriton ${AOTRITON_TAG} + ${AOTRITON_DB_TAG} gfx950 fwd DB, arches:" \
        "$(cat /app/aotriton_archs.txt)" \
    && python3 -c "import torch; print(f'torch={torch.__version__}')"

COPY --from=build_rocprofiler_sdk /staging/ /opt/rocm/
RUN ldconfig

# Drop the patched runtime onto every stock file name. The wheels ship
# libhsa-runtime64/libamdhip64 as hard links spread across _rocm_sdk_devel and
# _rocm_sdk_core, and torch's RPATH reaches both, so overwrite each regular file in place
# instead of re-pointing symlinks: our hip carries a different build suffix
# (...60850-cf439e5 vs ...60850-0000000), so a symlink swap would leave the wheel's copy
# reachable under its own name. The count check is there to fail loudly if a future SDK
# lays the libraries out somewhere else, rather than shipping the stock runtime silently.
RUN --mount=type=bind,from=build_rocm_runtime,src=/staging/lib,target=/rocm-runtime \
    set -eux; \
    ours_hsa=$(readlink -f /rocm-runtime/libhsa-runtime64.so.1); \
    ours_hip=$(readlink -f /rocm-runtime/libamdhip64.so.7); \
    patched=0; \
    for d in "${SDK_DEV}/lib" "${SDK_CORE}/lib"; do \
        [ -d "$d" ] || continue; \
        for f in "$d"/libhsa-runtime64.so.1* "$d"/libamdhip64.so.7*; do \
            [ -f "$f" ] && [ ! -L "$f" ] || continue; \
            case "$f" in *libhsa*) cp -f "$ours_hsa" "$f";; *) cp -f "$ours_hip" "$f";; esac; \
            echo "patched $f"; \
            patched=$((patched+1)); \
        done; \
    done; \
    test "$patched" -ge 3; \
    ldconfig; \
    python3 -c "import ctypes; ctypes.CDLL('libhsa-runtime64.so.1').hsa_amd_signal_create_v2"; \
    strings "$ours_hip" | grep -q 'Ordering edge signals'; \
    echo "ROCr + clr ordering edge signals installed"

ARG BASE_IMAGE
ARG PYTHON_VERSION
ARG ROCM_SDK_VERSION
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION
ARG TORCHVISION_VERSION
ARG PYTORCH_ROCM_ARCH
ARG AITER_ROCM_ARCH
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG FA_BRANCH
ARG FA_REPO
ARG AITER_BRANCH
ARG AITER_REPO
ARG MORI_BRANCH
ARG MORI_REPO
ARG ROCPROFILER_SDK_REPO
ARG ROCPROFILER_SDK_COMMIT
ARG ROCM_RUNTIME_REPO
ARG ROCM_RUNTIME_COMMIT
# The other four AOTriton ARGs are already in scope from the overlay block above.
ARG AOTRITON_DB_SHA256
# Record hashes for Triton and pybind11 so we can verify later.
RUN echo "BASE_IMAGE: ${BASE_IMAGE}" > /app/versions.txt \
    && echo "ROCPROFILER_SDK_REPO: ${ROCPROFILER_SDK_REPO}" >> /app/versions.txt \
    && echo "ROCPROFILER_SDK_COMMIT: ${ROCPROFILER_SDK_COMMIT}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_REPO: ${ROCM_RUNTIME_REPO}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_COMMIT: ${ROCM_RUNTIME_COMMIT}" >> /app/versions.txt \
    && echo "AOTRITON_REPO: ${AOTRITON_REPO}" >> /app/versions.txt \
    && echo "AOTRITON_TAG: ${AOTRITON_TAG}" >> /app/versions.txt \
    # Which tuning DB an image carries is otherwise unrecoverable after the build.
    && echo "AOTRITON_DB_TAG: ${AOTRITON_DB_TAG} (gfx950 attn_fwd only)" >> /app/versions.txt \
    && echo "AOTRITON_DB_SHA256: ${AOTRITON_DB_SHA256}" >> /app/versions.txt \
    && echo "AOTRITON_ARCHS: $(cat /app/aotriton_archs.txt)" >> /app/versions.txt \
    # Marks an iteration build so a partial-arch image cannot pass for a release.
    && echo "AOTRITON_ALLOW_PARTIAL_ARCH: ${AOTRITON_ALLOW_PARTIAL_ARCH}" >> /app/versions.txt \
    && echo "PYTHON_VERSION: ${PYTHON_VERSION}" >> /app/versions.txt \
    && echo "ROCM_SDK_VERSION: ${ROCM_SDK_VERSION}" >> /app/versions.txt \
    && echo "TORCH_VERSION: ${TORCH_VERSION}" >> /app/versions.txt \
    && echo "TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION}" >> /app/versions.txt \
    && echo "TORCHVISION_VERSION: ${TORCHVISION_VERSION}" >> /app/versions.txt \
    && echo "PYTORCH_ROCM_ARCH: ${PYTORCH_ROCM_ARCH}" >> /app/versions.txt \
    && echo "AITER_ROCM_ARCH: ${AITER_ROCM_ARCH}" >> /app/versions.txt \
    && echo "TRITON_BRANCH: ${TRITON_BRANCH}" >> /app/versions.txt \
    && echo "TRITON_REPO: ${TRITON_REPO}" >> /app/versions.txt \
    && echo "FA_BRANCH: ${FA_BRANCH}" >> /app/versions.txt \
    && echo "FA_REPO: ${FA_REPO}" >> /app/versions.txt \
    && echo "AITER_BRANCH: ${AITER_BRANCH}" >> /app/versions.txt \
    && echo "AITER_REPO: ${AITER_REPO}" >> /app/versions.txt \
    && echo "MORI_BRANCH: ${MORI_BRANCH}" >> /app/versions.txt \
    && echo "MORI_REPO: ${MORI_REPO}" >> /app/versions.txt \
    # Fingerprint our triton so Dockerfile.rocm can prove it survived the build.
    && echo "TRITON_VERSION: $(pip show triton | awk '/^Version:/ {print $2}')" >> /app/versions.txt \
    && echo "TRITON_SHA256: $(find $(python3 -c 'import triton, os; print(os.path.dirname(triton.__file__))') \
        -type f \( -name '*.py' -o -name '*.so' \) | sort | xargs sha256sum | sha256sum | cut -d' ' -f1)" \
        >> /app/versions.txt \
    && echo "PYBIND11_VERSION: $(pip show pybind11 | awk '/^Version:/ {print $2}')" >> /app/versions.txt \
    && echo "PYBIND11_INTERNALS_VERSION: $(grep -rhE '^#[[:space:]]*define PYBIND11_INTERNALS_VERSION' \
        $(python3 -c 'import pybind11; print(pybind11.get_include())') | awk '{print $NF}')" \
        >> /app/versions.txt \
    && echo "PYBIND11_SHA256: $(find $(python3 -c 'import pybind11; print(pybind11.get_include())') \
        -type f -name '*.h' | sort | xargs sha256sum | sha256sum | cut -d' ' -f1)" \
        >> /app/versions.txt
